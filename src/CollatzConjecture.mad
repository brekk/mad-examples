import { toInteger } from "Float"
import IO from "IO"
import List from "List"
import Math from "Math"
import Number from "Number"



collatzStep :: Integer -> Integer
collatzStep = (x) => (Math.mod(x, 2) != 0 ? 3 * x + 1 : toInteger(x / 2))
collatz :: Integer -> List Integer
collatz = (reallyLongVariableNameBecauseICan) => (
  reallyLongVariableNameBecauseICan == 1
    ? [1]
    : [
      reallyLongVariableNameBecauseICan,
      ...collatz(collatzStep(reallyLongVariableNameBecauseICan)),
    ]
)
main = () => {
  hail = #- Math.round(Math.random() * 1e10) -#
  // hail = 17
  IO.trace("starting!", hail)
  hailed = collatz(hail)
  hailed |> IO.log
  hailed |> List.length |> IO.trace("total hailstone steps!")
}
